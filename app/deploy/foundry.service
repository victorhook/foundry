# /etc/systemd/system/foundry.service
[Unit]
Description=Foundry — personal workout tracker
After=network.target

[Service]
Type=simple
User=victor
WorkingDirectory=/opt/foundry
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1
# The AI chat page shells out to the `claude` CLI, which needs a HOME (that's
# where it keeps credentials and the session transcripts `--resume` reads) and a
# PATH that includes wherever it was installed. These MUST match the User= above:
# the CLI is installed per-user into ~/.local/bin. Harmless if the AI chat isn't
# set up. See docs/ai-chat.md.
Environment=HOME=/home/victor
Environment=PATH=/home/victor/.local/bin:/usr/local/bin:/usr/bin:/bin
# adapter-node rejects request bodies over BODY_SIZE_LIMIT (default 512K) *before*
# the route runs, so program PDFs and exercise images 413'd without ever reaching
# /api/upload's own 25 MB check. Keep this in step with MAX_BYTES in
# src/routes/api/upload/+server.ts, and with client_max_body_size in setup-nginx.sh.
Environment=BODY_SIZE_LIMIT=25M
EnvironmentFile=/opt/foundry/.env
ExecStart=/usr/bin/node build
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
