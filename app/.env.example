# Copy to .env and fill in. On the server this lives at /opt/foundry/.env
AUTH_SECRET=            # long random string; sign-in sessions depend on it
ADMIN_USER=             # your login username (created on first DB init)
ADMIN_PASSWORD=         # your login password (created on first DB init)
DATABASE_PATH=data/foundry.db
PORT=3000               # adapter-node listens here; Caddy proxies to it
HOST=127.0.0.1

# --- Read-only automation API + MCP server (optional) ---
# A single shared secret granting READ-ONLY access: GET /api/* for scripts and
# custom GPT Actions (docs/api.md), and the MCP endpoint at POST /mcp for
# ChatGPT/Claude connectors (docs/mcp.md). Generate with `openssl rand -hex 32`.
# Leave blank to disable both.
API_TOKEN=

# --- Google Fit (optional, for daily steps) ---
# Create an OAuth 2.0 "Web application" client in Google Cloud (see DEPLOY.md),
# enable the Fitness API, and add <your-origin>/api/fit/callback as an authorized
# redirect URI. Leave blank to hide the "Connect Google Fit" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if the auto-detected origin is wrong (e.g. behind an odd proxy).
# Must exactly match the redirect URI registered in the Google console.
# GOOGLE_REDIRECT_URI=https://foundry.example.com/api/fit/callback
# Set to your timezone so Fit steps are bucketed by YOUR calendar day, not the
# server's (a UTC server otherwise splits days ~2h off). IANA name, e.g.:
TZ=Europe/Stockholm

# --- Pain reminders via Web Push (optional) ---
# Generate one keypair once with `npx web-push generate-vapid-keys` and paste
# below. Leave blank to hide the reminders UI. VAPID_SUBJECT is a contact URL
# the push services can reach you at (mailto: or https:). TZ (above) controls
# which local time reminders fire at.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- AI chat (optional, needs the `claude` CLI on the server) ---
# The AI chat page shells out to the Claude Code CLI. With the CLI absent the
# page just explains that it isn't set up. Full setup: docs/ai-chat.md
# Auth uses your Claude subscription, not an API key: run `claude setup-token`
# as the service user and paste the long-lived token it prints here. (If you'd
# rather rely on `claude auth login`'s ~/.claude/.credentials.json, leave this
# blank — but then a logout in your own shell breaks the chat page.)
CLAUDE_CODE_OAUTH_TOKEN=
# Absolute path to the CLI, if it isn't on the service's PATH.
# CLAUDE_BIN=/home/victor/.local/bin/claude
# Scratch directory the agent works in. Relative paths resolve from the app's
# working directory (/opt/foundry in production).
# AI_WORKSPACE=/opt/foundry/ai-workspace
# Model alias or full name; defaults to whatever the CLI is configured to use.
# CLAUDE_MODEL=opus
# Hard ceiling on one turn before the child process is killed (default 600000).
# CLAUDE_TURN_TIMEOUT_MS=600000
